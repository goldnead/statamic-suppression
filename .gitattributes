# Everything tracked here is downloaded into every site that installs this
# package unless it is export-ignored. Tests and CI config are dead weight in
# a consumer's vendor/ directory.
#
# Keep: /src, /config, /database (the migrations are the product), README.md,
# CHANGELOG.md, LICENSE. This package has no frontend build and no /resources.

/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/phpunit.xml        export-ignore
/phpunit.mysql.xml  export-ignore
/pint.json          export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/addon-lint.json    export-ignore

# Internal listing files: not needed by installing sites.
/art                export-ignore
